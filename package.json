{
  "name": "trice-auction-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "node --test",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "admin:promote-local": "node scripts/promote-local-admin.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs",
    "postinstall": "wrangler types",
    "build:staging": "CLOUDFLARE_ENV=staging react-router build",
    "deploy:staging": "npm run staging:check && npm run build:staging && node scripts/staging-config.mjs --built && wrangler deploy --config build/server/wrangler.json",
    "staging:check": "node scripts/staging-config.mjs",
    "db:migrate:staging": "npm run staging:check && wrangler d1 migrations apply trice-auction-db-staging --env staging --remote --config wrangler.jsonc",
    "db:seed:staging": "node scripts/seed-staging.mjs --env staging --remote",
    "smoke:staging": "node scripts/smoke-staging.mjs --env staging --remote"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.2",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.127.1"
  }
}
